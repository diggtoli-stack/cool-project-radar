{
  "version": "0.3.0",
  "defaultLookbackHours": 72,
  "defaultMaxCandidates": 36,
  "sources": [
    {
      "id": "hn_show",
      "name": "Hacker News Show HN",
      "type": "hn_algolia",
      "enabled": true,
      "reliability": "stable-free-no-key",
      "endpoint": "https://hn.algolia.com/api/v1/search_by_date",
      "use": "Fetch recent Show HN stories. High-signal launch/demo surface for new apps and tools.",
      "tags": "show_hn",
      "limit": 80
    },
    {
      "id": "hn_launch_keywords",
      "name": "Hacker News Launch Keywords",
      "type": "hn_algolia_queries",
      "enabled": true,
      "reliability": "stable-free-no-key",
      "endpoint": "https://hn.algolia.com/api/v1/search_by_date",
      "use": "Search recent HN stories for launch phrases that may not use Show HN.",
      "tags": "story",
      "limit": 25,
      "queries": [
        "\"I built\" app",
        "\"I made\" app",
        "\"just launched\" app",
        "\"weekend project\" app",
        "\"tiny app\"",
        "\"new interaction\" app",
        "\"photo filter\" app",
        "\"retro camera\" app",
        "\"template\" app",
        "\"vibe coded\"",
        "\"built with Cursor\"",
        "\"built with Lovable\""
      ]
    },
    {
      "id": "reddit_sideproject",
      "name": "Reddit Side Project Communities",
      "type": "reddit_listing",
      "enabled": true,
      "reliability": "best-effort-free-no-key",
      "endpoint": "https://www.reddit.com/r/{subreddit}/{listing}.json",
      "use": "Read public JSON listings from communities where makers post fresh apps, launches, and feedback requests.",
      "listing": "new",
      "limit": 40,
      "subreddits": [
        "SideProject",
        "indiehackers",
        "vibecoding",
        "SaaS",
        "EntrepreneurRideAlong",
        "InternetIsBeautiful",
        "iosapps",
        "chrome_extensions",
        "webdev",
        "replit",
        "lovable"
      ]
    },
    {
      "id": "product_hunt_rss",
      "name": "Product Hunt RSS",
      "type": "producthunt_rss",
      "enabled": true,
      "reliability": "stable-free-no-key-limited-detail",
      "endpoint": "https://www.producthunt.com/feed",
      "use": "Read Product Hunt Atom feed for newly launched products. Good for product names, taglines, discussion links, and launch dates; external product URLs are limited because Product Hunt uses redirect links and Cloudflare.",
      "limit": 60
    },
    {
      "id": "tech_media_rss",
      "name": "Tech/Product Media RSS",
      "type": "generic_rss",
      "enabled": true,
      "reliability": "stable-free-no-key-per-feed-varies",
      "use": "Read public RSS/Atom feeds from product and technology media. Best used as a secondary signal when articles mention new consumer apps or product trends.",
      "limit": 20,
      "feeds": [
        {
          "name": "The Verge",
          "url": "https://www.theverge.com/rss/index.xml"
        },
        {
          "name": "TechCrunch",
          "url": "https://techcrunch.com/feed/"
        },
        {
          "name": "Stratechery",
          "url": "https://stratechery.com/feed/"
        }
      ]
    },
    {
      "id": "youtube_channel_rss",
      "name": "YouTube Channel RSS",
      "type": "youtube_channel_rss",
      "enabled": true,
      "reliability": "stable-free-no-key-channel-list-required",
      "use": "Read official YouTube channel RSS feeds for recent videos from product reviewers, startup/product channels, and consumer-tech creators. This is channel monitoring, not global YouTube search.",
      "limit": 10,
      "channels": [
        {
          "name": "Marques Brownlee",
          "channelId": "UCBJycsmduvYEL83R_U4JriQ"
        },
        {
          "name": "The Verge",
          "channelId": "UCddiUEpeqJcYeBxX1IVBKvQ"
        },
        {
          "name": "Greg Isenberg",
          "channelId": "UCPjNBjflYl0-HQtUvOx0Ibw"
        }
      ]
    },
    {
      "id": "github_app_search",
      "name": "GitHub App/Extension Search",
      "type": "github_repo_search",
      "enabled": true,
      "reliability": "stable-free-no-key-rate-limited",
      "endpoint": "https://api.github.com/search/repositories",
      "use": "Search newly created repositories for app, extension, Lovable, Cursor, Replit, and vibe-coding signals. Best for open-source apps, demos, browser extensions, and templates; noisy without filtering.",
      "limit": 8,
      "sort": "stars",
      "order": "desc",
      "queries": [
        "created:>={since} topic:chrome-extension",
        "created:>={since} topic:ios app",
        "created:>={since} topic:mobile app",
        "created:>={since} lovable app",
        "created:>={since} replit app",
        "created:>={since} \"built with\" cursor app",
        "created:>={since} \"vibe coded\" app"
      ]
    },
    {
      "id": "firefox_addons",
      "name": "Firefox Add-ons Search",
      "type": "firefox_addons_search",
      "enabled": true,
      "reliability": "stable-free-no-key",
      "endpoint": "https://addons.mozilla.org/api/v5/addons/search/",
      "use": "Search recently created Firefox extensions. Good for AI assistant, browser side panel, writing, productivity, and page-enhancement tools.",
      "limit": 12,
      "queries": [
        "ai assistant",
        "productivity",
        "writing",
        "summarize",
        "side panel"
      ]
    },
    {
      "id": "apple_itunes_search",
      "name": "Apple iTunes App Search",
      "type": "itunes_app_search",
      "enabled": true,
      "reliability": "stable-free-no-key-keyword-limited",
      "endpoint": "https://itunes.apple.com/search",
      "use": "Keyword-search the App Store for recently released iOS apps. Useful as a supplementary app-store signal, but not a complete new-app feed.",
      "country": "us",
      "limit": 20,
      "queries": [
        "ai journal",
        "habit tracker",
        "ai photo",
        "retro camera",
        "photo filters",
        "aesthetic editor",
        "collage maker",
        "avatar maker",
        "sticker maker",
        "personal finance",
        "ai fitness",
        "ai notes",
        "travel planner"
      ]
    },
    {
      "id": "v2ex_create",
      "name": "V2EX Create/Share Nodes",
      "type": "v2ex_nodes",
      "enabled": true,
      "reliability": "stable-free-no-key",
      "endpoint": "https://www.v2ex.com/api/topics/show.json?node_name={node}",
      "use": "Read Chinese maker/share nodes for small tools, apps, and independent products.",
      "nodes": [
        "create",
        "share",
        "ideas",
        "programmer"
      ]
    },
    {
      "id": "lobsters_show",
      "name": "Lobsters Show",
      "type": "lobsters_tag",
      "enabled": true,
      "reliability": "stable-free-no-key",
      "endpoint": "https://lobste.rs/t/show.json",
      "use": "Read projects tagged show. Often developer-heavy, but useful for small demos and niche apps.",
      "tag": "show",
      "limit": 50
    },
    {
      "id": "bluesky_app_search",
      "name": "Bluesky Public Search",
      "type": "bluesky_search",
      "enabled": true,
      "reliability": "best-effort-free-no-key",
      "endpoint": "https://public.api.bsky.app/xrpc/app.bsky.feed.searchPosts",
      "use": "Search public posts for launch phrases and vibe-coding tool mentions.",
      "limit": 25,
      "queries": [
        "\"I built\" app",
        "\"I made\" app",
        "\"just launched\" app",
        "\"built with Cursor\"",
        "\"built with Lovable\"",
        "\"vibe coded\"",
        "\"weekend project\""
      ]
    },
    {
      "id": "xiaoyuzhou_podcasts",
      "name": "Xiaoyuzhou Podcasts",
      "type": "xiaoyuzhou_podcast",
      "enabled": false,
      "reliability": "stable-free-no-key-curated-podcast-list-required",
      "use": "Read public Xiaoyuzhou podcast pages directly and parse recent episode titles, shownotes, dates, and engagement. Enable after adding product/tech podcast ids in sourceOptions.",
      "limit": 12,
      "podcasts": []
    },
    {
      "id": "twitterapi_io_search",
      "name": "X/Twitter Search via TwitterAPI.io",
      "type": "twitterapi_io_search",
      "enabled": false,
      "reliability": "optional-api-key-third-party",
      "endpoint": "https://api.twitterapi.io/twitter/tweet/advanced_search",
      "apiKeyEnv": "TWITTERAPI_IO_KEY",
      "queryType": "Latest",
      "use": "Search X for high-value launch phrases and vibe-coding mentions. Requires TWITTERAPI_IO_KEY or sourceOptions.twitterapi_io_search.apiKey.",
      "limit": 25,
      "queries": [
        "\"built with Cursor\" app",
        "\"built with Lovable\" app",
        "\"vibe coded\" app",
        "\"I built\" \"app\"",
        "\"just launched\" \"app\"",
        "\"photo filter\" app",
        "\"retro camera\" app"
      ]
    },
    {
      "id": "wewe_rss",
      "name": "WeChat Official Accounts via WeWe RSS",
      "type": "wewe_rss",
      "enabled": false,
      "reliability": "optional-self-hosted-wechat-reading-login-required",
      "baseUrlEnv": "WEWE_RSS_BASE_URL",
      "use": "Read a self-hosted WeWe RSS instance for WeChat official-account articles. Requires WEWE_RSS_BASE_URL or sourceOptions.wewe_rss.baseUrl.",
      "limit": 30,
      "titleInclude": "产品|应用|App|小工具|上线|体验|AI|滤镜|模板|相机|独立开发",
      "feeds": [
        {
          "id": "all",
          "name": "all"
        }
      ]
    }
  ],
  "notUsed": [
    {
      "id": "product_hunt_graphql",
      "name": "Product Hunt GraphQL API",
      "reason": "Official GraphQL API is richer than RSS, but requires an access token and has usage restrictions. RSS is enabled by default; GraphQL can be added later as an optional token-backed adapter."
    },
    {
      "id": "chrome_web_store_search",
      "name": "Chrome Web Store Search",
      "reason": "The official Chrome Web Store API is primarily for publishing/managing extensions, not public search discovery. Keep using Chrome Web Store links found from Reddit/GitHub, and add direct metadata enrichment later."
    },
    {
      "id": "youtube_search",
      "name": "YouTube Search",
      "reason": "Useful for demo videos, but official search needs an API key and has high quota cost per query. Use YouTube channel RSS for default monitoring; add official search later for a video-demo mode."
    },
    {
      "id": "public_rsshub_instances",
      "name": "Public RSSHub instances as hard dependency",
      "reason": "RSSHub routes are useful, but public instances can timeout or be blocked. Prefer direct parsers or a self-hosted RSSHub instance for sources such as Xiaoyuzhou."
    },
    {
      "id": "xiaohongshu_douyin_tiktok_instagram",
      "name": "小红书 / 抖音 / TikTok / Instagram",
      "reason": "Login, anti-bot controls, app-only content, and unstable HTML make them poor default sources. Treat as future browser-automation or third-party-API adapters."
    },
    {
      "id": "google_play_search",
      "name": "Google Play search",
      "reason": "No stable official public search API for broad discovery. Add later through a vetted third-party API or enrichment from already discovered Play Store links."
    }
  ],
